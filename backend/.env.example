# Copy this file to .env in the same folder (backend/) and fill in real values.
# .env itself is gitignored - never commit real keys.

# Get a free key at console.groq.com/keys - no card required
GROQ_API_KEY=

# Get test-mode keys at dashboard.razorpay.com -> Settings -> API Keys
# (toggle "Test Mode" in the dashboard before generating these)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# RazorpayX Payouts (for fleet payment on delivery) — optional, mocked if not set.
# Get these from dashboard.razorpay.com -> RazorpayX -> API
RAZORPAY_X_ACCOUNT_NUMBER=

# Fleet fund account mapping (JSON). Register each fleet partner as a contact
# in RazorpayX, then map fleet_name -> fund_account_id here.
# Example: FLEET_FUND_ACCOUNTS={"Porter (Mumbai)":"fa_abc123","Borzo (Bengaluru)":"fa_def456"}
FLEET_FUND_ACCOUNTS=

# Webhook secrets — used to verify incoming webhooks from Razorpay and couriers.
# Generate in Razorpay dashboard -> Settings -> Webhooks. Optional for demo.
RAZORPAY_WEBHOOK_SECRET=

COURIER_WEBHOOK_SECRET=

NGROK_AUTHTOKEN=
